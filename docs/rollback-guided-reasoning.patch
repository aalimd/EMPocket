 test('authored practice scenarios have facts, distinct choices and option-specific feedback',()=>{const S=load();assert.equal(S.cases.length,12);for(const c of S.cases){assert.ok(c.stem.length>100,c.id);assert.equal(c.questions.length,2);for(const q of c.questions){assert.equal(q.options.filter(o=>o.correct).length,1);assert.equal(new Set(q.options.map(o=>o.id)).size,3);assert.ok(q.options.every(o=>o.why.length>20));}const html=S.render(S.cases.indexOf(c));assert.match(html,/class="case-complete" hidden/);for(const q of c.questions)for(const o of q.options)assert.ok(!html.includes(o.why),'Feedback leaked before attempt');}});
